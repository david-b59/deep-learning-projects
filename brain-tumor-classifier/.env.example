# Copiez ce fichier en .env (ne commitez jamais .env) et renseignez les valeurs.

# Jeton de l'API Kaggle (téléchargement des données) :
# https://www.kaggle.com/settings -> section « API Tokens » -> « Generate New Token »
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Hugging Face Hub (publication des poids du modèle)
HF_TOKEN=

# API : adresse du front autorisée par CORS
CORS_ORIGIN=http://localhost:5173
