# Deux modes de fonctionnement du site :
#
# 1) Mode navigateur (par défaut, version publique) : VITE_API_URL n'est pas défini.
#    Le modèle ONNX est téléchargé une fois puis tourne dans le navigateur ; l'image n'est
#    envoyée nulle part.
#
# 2) Mode API (Docker) : décommente la ligne suivante pour appeler le serveur FastAPI.
# VITE_API_URL=http://localhost:8000

# Adresse du fichier du modèle ONNX (mode navigateur). Par défaut : le dépôt Hugging Face
# du projet. Pour tester en local sans publier : copie models/export/model.onnx dans
# frontend/public/models/ (dossier ignoré par git) et utilise /models/model.onnx.
# VITE_MODEL_URL=/models/model.onnx
